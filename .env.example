# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres@127.0.0.1:5432/wa_automation

# ---------------------------------------------------------------------------
# WhatsApp Cloud API
#
# Leave WHATSAPP_MOCK=true until Meta has verified your business and approved
# your templates — the whole app works, nothing is actually sent.
# ---------------------------------------------------------------------------
WHATSAPP_MOCK=true

# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Use a System User token, not the 24-hour temporary one.
WHATSAPP_ACCESS_TOKEN=
# App Dashboard > Settings > Basic > App Secret. Verifies webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string; you type the same value into the webhook setup form.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# Decides whose birthday it is "today".
BUSINESS_TIMEZONE=Asia/Kolkata
# Bare local numbers are parsed against this country.
DEFAULT_PHONE_COUNTRY=IN
# Remind this many days before each renewal date.
RENEWAL_REMINDER_DAYS=30,7,1

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_BATCH_SIZE=25
WORKER_POLL_MS=2000
WORKER_RATE_PER_SECOND=10
MESSAGE_MAX_ATTEMPTS=5

# Protects /api/cron/* once deployed. Send as: Authorization: Bearer <value>
CRON_SECRET=
